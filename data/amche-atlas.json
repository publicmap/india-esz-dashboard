{
  "name": "MoEF ESZ Notifications",
  "description": "Protected areas of India and the status of their Eco-Sensitive Zone (ESZ) notifications by MoEFCC. Green = final ESZ notified, amber = draft only, grey = not yet notified.",
  "center": [
    82,
    22
  ],
  "zoom": 4.2,
  "inspect": {
    "id": "wikidataId",
    "title": "name",
    "label": "name",
    "fields": [
      "protectedAreaType",
      "state",
      "eszStatus",
      "notificationStatus",
      "notificationDate",
      "orderNumber",
      "iucnCategory",
      "area"
    ]
  },
  "layers": [
    {
      "id": "protected-areas",
      "type": "geojson",
      "title": "Protected Areas (ESZ status)",
      "description": "All Indian protected areas with a known location, colored by Eco-Sensitive Zone notification status.",
      "url": "https://raw.githubusercontent.com/publicmap/india-esz-dashboard/main/data/protected-areas.geojson",
      "initiallyChecked": true,
      "attribution": "Wikidata, MoEFCC ESZ notifications",
      "style": {
        "circle-color": [
          "match",
          [
            "get",
            "eszStatus"
          ],
          "final",
          "#0ca30c",
          "draft",
          "#fab219",
          "#898781"
        ],
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          3,
          10,
          8
        ],
        "circle-stroke-color": "#111827",
        "circle-stroke-width": 0.5,
        "text-field": [
          "get",
          "name"
        ]
      },
      "inspect": {
        "id": "wikidataId",
        "title": "name",
        "label": "name",
        "fields": [
          "protectedAreaType",
          "state",
          "eszStatus",
          "notificationStatus",
          "notificationDate",
          "orderNumber",
          "iucnCategory",
          "area"
        ]
      }
